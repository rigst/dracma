# Variáveis de Ambiente — Dracma
# Copie para .env e ajuste os valores.

SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.development
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:8000

# Redis — DBs EXCLUSIVOS deste app (conferido em 14/09/2026 no servidor:
# 0,1,2,3,9,10 já ocupados). 4=cache, 5=sessões, 6=broker/result do Celery.
REDIS_URL=redis://localhost:6379/6
CACHE_REDIS_URL=redis://localhost:6379/4
SESSION_REDIS_URL=redis://localhost:6379/5

# PostgreSQL (produção) — usado apenas por config.settings.production
DB_NAME=dracma
DB_USER=dracma
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432

# IA — Anthropic / Claude
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
# Registrar gasto é mecânico (low); pergunta analítica precisa de julgamento (high).
AI_EFFORT_REGISTRO=low
AI_EFFORT_ANALISE=high
AI_MAX_TOKENS=4000
AI_HISTORICO_TURNOS=10

# Quotas mensais de tokens. O visitante é anônimo e a demo é pública.
QUOTA_TOKENS_DEFAULT=2000000
QUOTA_TOKENS_VISITOR=100000
# Rajada por pessoa no console e no WhatsApp.
AI_LIMITE_MENSAGENS=30
AI_JANELA_S=600
AI_MAX_CHARS_MENSAGEM=2000
# Teto de iterações do loop de tool use: uma ferramenta em laço não pode
# queimar a quota de quem está conversando.
AI_MAX_ITERACOES=5

# Transcrição local (faster-whisper). Requer ffmpeg no sistema.
# O diretório do modelo fica FORA da árvore do projeto: em BASE_DIR, cada
# deploy limpo rebaixaria ~500 MB.
WHISPER_MODELO=small
WHISPER_COMPUTE_TYPE=int8
WHISPER_CACHE_DIR=/var/lib/dracma/whisper
WHISPER_IDIOMA=pt
WHISPER_DEVICE=cpu
# Áudio mais longo é recusado em vez de ocupar o worker por minutos.
WHISPER_MAX_SEGUNDOS=180

# Telegram (Bot API). Com TELEGRAM_ENABLED=False o webhook responde 404
# e o envio é no-op — o canal cai para o console.
TELEGRAM_ENABLED=False
# Token do BotFather, no formato "<id do bot>:<segredo>". É a credencial
# INTEIRA do bot: quem a tem lê e escreve toda conversa. Nunca versione.
TELEGRAM_BOT_TOKEN=
# O @username do bot, sem o "@". Monta o deep link t.me e o QR da tela de
# conexão; não é segredo e aparece em página pública.
TELEGRAM_BOT_USERNAME=
# Escolhido por você e informado no setWebhook. O Telegram o repete em
# X-Telegram-Bot-Api-Secret-Token a cada POST; como a Bot API não assina o
# corpo, é isto que autentica o webhook. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=
# Teto do download de mídia. Acima de 20 MB a api.telegram.org não entrega;
# aumentar só adianta com um Bot API Server local em TELEGRAM_API_BASE.
TELEGRAM_MAX_MIDIA_BYTES=20971520

# E-mail. ATENÇÃO: o padrão do código é o backend de CONSOLE, que escreve a
# mensagem no log e não entrega nada. Em produção isso significa instruções de
# conexão e recuperação de senha sumindo em silêncio — troque as quatro linhas
# abaixo antes de subir.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Porta 587 → STARTTLS (TLS=True). Porta 465 → SSL implícito (SSL=True).
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=Dracma <no-reply@dracma.stolben.com>

# Monitoramento de erros. Vazio = desligado.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0
DJANGO_LOG_LEVEL=INFO

# Auto-cadastro por e-mail (rotas respondem 404 enquanto False)
SIGNUP_ENABLED=True
# Expiração do visitante, em horas de inatividade.
VISITOR_EXPIRY_HOURS=48

# Regras do domínio
# Percentual do limite em que sai o primeiro aviso (o segundo é no estouro).
LIMITE_ALERTA_PERCENTUAL=80
# Hora do lembrete diário de vencimentos.
HORA_LEMBRETE=9
