# Variáveis de Ambiente — Centavo
# Copie para .env e ajuste os valores.

SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.development
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:8000

# Redis — DBs EXCLUSIVOS deste app (conferido em 14/09/2026 no servidor:
# 0,1,2,3,9,10 já ocupados). 4=cache, 5=sessões, 6=broker/result do Celery.
REDIS_URL=redis://localhost:6379/6
CACHE_REDIS_URL=redis://localhost:6379/4
SESSION_REDIS_URL=redis://localhost:6379/5

# PostgreSQL (produção) — usado apenas por config.settings.production
DB_NAME=centavo
DB_USER=centavo
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432

# IA — Anthropic / Claude
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
# Registrar gasto é mecânico (low); pergunta analítica precisa de julgamento (high).
AI_EFFORT_REGISTRO=low
AI_EFFORT_ANALISE=high
AI_MAX_TOKENS=4000
AI_HISTORICO_TURNOS=10

# Quotas mensais de tokens. O visitante é anônimo e a demo é pública.
QUOTA_TOKENS_DEFAULT=2000000
QUOTA_TOKENS_VISITOR=100000

# Transcrição local (faster-whisper). Requer ffmpeg no sistema.
# O diretório do modelo fica FORA da árvore do projeto: em BASE_DIR, cada
# deploy limpo rebaixaria ~500 MB.
WHISPER_MODELO=small
WHISPER_COMPUTE_TYPE=int8
WHISPER_CACHE_DIR=/var/lib/centavo/whisper

# WhatsApp Cloud API (Meta). Com WHATSAPP_ENABLED=False o webhook responde 404
# e o envio é no-op — o canal cai para o console.
WHATSAPP_ENABLED=False
WHATSAPP_API_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Escolhido por você e repetido no painel da Meta (handshake GET do webhook).
WHATSAPP_VERIFY_TOKEN=
# App Secret do app da Meta: assina cada POST em X-Hub-Signature-256.
WHATSAPP_APP_SECRET=
# Templates utility aprovados, usados quando a janela de 24h está fechada.
# Vazio = o alerta é adiado em vez de enviado.
WHATSAPP_TEMPLATE_LIMITE=
WHATSAPP_TEMPLATE_VENCIMENTO=

# E-mail
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Centavo <no-reply@centavo.stolben.com>

# Auto-cadastro por e-mail (rotas respondem 404 enquanto False)
SIGNUP_ENABLED=True
