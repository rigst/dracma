[Unit]
Description=Dracma (Gunicorn)
After=network.target

[Service]
Type=simple
User=rod
Group=www-data
WorkingDirectory=/var/www/dracma
EnvironmentFile=/var/www/dracma/.env
Environment=DJANGO_SETTINGS_MODULE=config.settings.production
ExecStart=/var/www/dracma/venv/bin/gunicorn config.wsgi:application \
    --bind 127.0.0.1:8015 \
    --workers 3 \
    --timeout 300 \
    --access-logfile /var/www/dracma/logs/gunicorn.access.log \
    --error-logfile /var/www/dracma/logs/gunicorn.error.log
# O CD recarrega em vez de reiniciar: SIGHUP troca os workers sem derrubar o
# socket de escuta, então não há janela de 502. Sem esta linha o systemd não
# sabe recarregar um Type=simple e o `systemctl reload` do deploy falha na hora
# — depois do merge e do pip install, com o processo antigo ainda no ar.
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=5
KillSignal=SIGQUIT
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
